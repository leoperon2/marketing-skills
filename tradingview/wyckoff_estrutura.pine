//@version=5
// Wyckoff Estrutura - indicador original baseado no método Wyckoff (domínio público).
// Detecta clímax (SC/BC), range (AR), Spring/UTAD, Teste, SOS/SOW e LPS/LPSY,
// desenha a caixa da estrutura, o stop e um painel com a fase atual.
// Ferramenta de leitura: não garante resultado.
indicator("Wyckoff Estrutura", shorttitle="Wyckoff", overlay=true, max_boxes_count=100, max_labels_count=300, max_lines_count=100)

// ───────── Inputs ─────────
lookback   = input.int(60, "Janela do clímax (barras)", minval=20, group="Detecção")
volLen     = input.int(20, "Média de volume", minval=5, group="Detecção")
volMult    = input.float(1.8, "Volume de clímax (x média)", step=0.1, group="Detecção")
sprdMult   = input.float(1.5, "Amplitude de clímax (x ATR)", step=0.1, group="Detecção")
arBars     = input.int(8, "Barras para confirmar o AR", minval=3, group="Detecção")
tolATR     = input.float(0.5, "Tolerância ST/Teste/LPS (x ATR)", step=0.1, group="Detecção")
showLabels = input.bool(true, "Mostrar rótulos", group="Visual")
showPanel  = input.bool(true, "Mostrar painel Radar", group="Visual")
accCol     = input.color(color.new(#16c47f, 85), "Cor acumulação", group="Visual")
disCol     = input.color(color.new(#ff5252, 85), "Cor distribuição", group="Visual")

// ───────── Base ─────────
atr      = ta.atr(14)
volMa    = ta.sma(volume, volLen)
trend    = ta.sma(close, 50)
wide     = (high - low) > atr * sprdMult
hiVol    = volume > volMa * volMult
lowestN  = ta.lowest(low, lookback)
highestN = ta.highest(high, lookback)
arHigh   = ta.highest(high, arBars)
arHighOf = ta.highestbars(high, arBars)
arLow    = ta.lowest(low, arBars)
arLowOf  = ta.lowestbars(low, arBars)

isSC = hiVol and wide and low <= lowestN and close < trend
isBC = hiVol and wide and high >= highestN and close > trend

// ───────── Estado ─────────
// mode: 1 = acumulação, -1 = distribuição, 0 = nenhuma
// stage: 1=A (clímax) 2=B (range) 3=C (Spring/UTAD) 4=D (SOS/SOW) 5=E (tendência)
var int   mode    = 0
var int   stage   = 0
var int   cBar    = na
var float cVol    = na
var float rHi     = na
var float rLo     = na
var float ext     = na
var int   extBar  = na
var int   sosBar  = na
var bool  testOk  = false
var int   lastST  = -100
var box   rBox    = na
var line  stopLn  = na

bool evSpring = false
bool evUtad   = false
bool evSos    = false
bool evSow    = false
bool evLps    = false
bool evLpsy   = false

lbl(txt, x, y, below, col) =>
    label.new(x, y, txt, style = below ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small)

// ───────── Lógica ─────────
if isSC and not (mode == 1 and stage >= 3)
    mode := 1
    stage := 1
    cBar := bar_index
    cVol := volume
    rLo := low
    rHi := na
    ext := na
    testOk := false
    if showLabels
        lbl("SC", bar_index, low, true, color.new(#0ea769, 0))

else if isBC and not (mode == -1 and stage >= 3)
    mode := -1
    stage := 1
    cBar := bar_index
    cVol := volume
    rHi := high
    rLo := na
    ext := na
    testOk := false
    if showLabels
        lbl("BC", bar_index, high, false, color.new(#d63031, 0))

else if mode == 1
    if stage == 1
        rLo := math.min(rLo, low)
        if bar_index == cBar + arBars
            if arHigh - rLo > atr * 2
                rHi := arHigh
                stage := 2
                rBox := box.new(cBar, rHi, bar_index, rLo, border_color = color.new(#16c47f, 40), bgcolor = accCol)
                if showLabels
                    lbl("AR", bar_index + arHighOf, rHi, false, color.new(#636e72, 0))
            else
                mode := 0
    else if stage == 2
        if low < rLo and close > rLo and low > rLo - 2 * atr
            stage := 3
            ext := low
            extBar := bar_index
            testOk := false
            evSpring := true
            stopLn := line.new(bar_index, ext - 0.2 * atr, bar_index + 1, ext - 0.2 * atr, extend = extend.right, color = color.new(#ff5252, 0), style = line.style_dashed)
            if showLabels
                lbl("Spring", bar_index, low, true, color.new(#0ea769, 0))
        else if close > rHi and volume > volMa
            stage := 4
            sosBar := bar_index
            evSos := true
            if showLabels
                lbl("SOS", bar_index, low, true, color.new(#0984e3, 0))
        else if low <= rLo + tolATR * atr and low >= rLo - tolATR * atr and close > rLo and volume < cVol and bar_index - lastST > 5
            lastST := bar_index
            if showLabels
                lbl("ST", bar_index, low, true, color.new(#636e72, 0))
        else if close < rLo - atr
            mode := 0
    else if stage == 3
        if close < ext - 0.2 * atr
            mode := 0
        else if close > rHi and volume > volMa
            stage := 4
            sosBar := bar_index
            evSos := true
            if showLabels
                lbl("SOS", bar_index, low, true, color.new(#0984e3, 0))
        else if not testOk and bar_index > extBar + 1 and low <= ext + tolATR * atr and low >= ext - 0.2 * atr and volume < volMa
            testOk := true
            if showLabels
                lbl("Teste", bar_index, low, true, color.new(#00b894, 0))
    else if stage == 4
        if close < rLo
            mode := 0
        else if bar_index > sosBar and low <= rHi + tolATR * atr and close > rHi and volume < volMa
            stage := 5
            evLps := true
            if showLabels
                lbl("LPS", bar_index, low, true, color.new(#00b894, 0))
    else if stage == 5
        if close < rLo
            mode := 0

else if mode == -1
    if stage == 1
        rHi := math.max(rHi, high)
        if bar_index == cBar + arBars
            if rHi - arLow > atr * 2
                rLo := arLow
                stage := 2
                rBox := box.new(cBar, rHi, bar_index, rLo, border_color = color.new(#ff5252, 40), bgcolor = disCol)
                if showLabels
                    lbl("AR", bar_index + arLowOf, rLo, true, color.new(#636e72, 0))
            else
                mode := 0
    else if stage == 2
        if high > rHi and close < rHi and high < rHi + 2 * atr
            stage := 3
            ext := high
            extBar := bar_index
            testOk := false
            evUtad := true
            stopLn := line.new(bar_index, ext + 0.2 * atr, bar_index + 1, ext + 0.2 * atr, extend = extend.right, color = color.new(#ff5252, 0), style = line.style_dashed)
            if showLabels
                lbl("UTAD", bar_index, high, false, color.new(#d63031, 0))
        else if close < rLo and volume > volMa
            stage := 4
            sosBar := bar_index
            evSow := true
            if showLabels
                lbl("SOW", bar_index, high, false, color.new(#6c5ce7, 0))
        else if high >= rHi - tolATR * atr and high <= rHi + tolATR * atr and close < rHi and volume < cVol and bar_index - lastST > 5
            lastST := bar_index
            if showLabels
                lbl("ST", bar_index, high, false, color.new(#636e72, 0))
        else if close > rHi + atr
            mode := 0
    else if stage == 3
        if close > ext + 0.2 * atr
            mode := 0
        else if close < rLo and volume > volMa
            stage := 4
            sosBar := bar_index
            evSow := true
            if showLabels
                lbl("SOW", bar_index, high, false, color.new(#6c5ce7, 0))
        else if not testOk and bar_index > extBar + 1 and high >= ext - tolATR * atr and high <= ext + 0.2 * atr and volume < volMa
            testOk := true
            if showLabels
                lbl("Teste", bar_index, high, false, color.new(#d63031, 0))
    else if stage == 4
        if close > rHi
            mode := 0
        else if bar_index > sosBar and high >= rLo - tolATR * atr and close < rLo and volume < volMa
            stage := 5
            evLpsy := true
            if showLabels
                lbl("LPSY", bar_index, high, false, color.new(#d63031, 0))
    else if stage == 5
        if close > rHi
            mode := 0

// estende a caixa enquanto a estrutura está ativa
if mode != 0 and not na(rBox)
    box.set_right(rBox, bar_index)

// ───────── Painel Radar ─────────
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(#0a0f1a, 10), border_width = 1, border_color = color.new(#22314d, 0))
if showPanel and barstate.islast
    phase = switch stage
        1 => "A"
        2 => "B"
        3 => "C"
        4 => "D"
        5 => "E"
        => "-"
    structTxt = mode == 1 ? "Acumulação" : mode == -1 ? "Distribuição" : "Sem estrutura"
    rangeTxt = mode != 0 and stage >= 2 ? str.tostring(rLo, format.mintick) + " – " + str.tostring(rHi, format.mintick) : "-"
    nextTxt = "Aguardando clímax (SC/BC)"
    if mode == 1
        nextTxt := switch stage
            1 => "Aguardando AR"
            2 => "Spring ou SOS acima de " + str.tostring(rHi, format.mintick)
            3 => "Teste do Spring e depois SOS"
            4 => "Aguardar LPS (reteste da resistência)"
            5 => "Tendência de alta: stop abaixo do range"
            => "-"
    else if mode == -1
        nextTxt := switch stage
            1 => "Aguardando AR"
            2 => "UTAD ou SOW abaixo de " + str.tostring(rLo, format.mintick)
            3 => "Teste do UTAD e depois SOW"
            4 => "Aguardar LPSY (reteste do suporte)"
            5 => "Tendência de baixa: stop acima do range"
            => "-"
    tc = color.white
    table.cell(panel, 0, 0, "Estrutura", text_color = tc, text_halign = text.align_left)
    table.cell(panel, 1, 0, structTxt, text_color = mode == 1 ? #16c47f : mode == -1 ? #ff6b6b : tc)
    table.cell(panel, 0, 1, "Fase", text_color = tc, text_halign = text.align_left)
    table.cell(panel, 1, 1, phase, text_color = tc)
    table.cell(panel, 0, 2, "Range", text_color = tc, text_halign = text.align_left)
    table.cell(panel, 1, 2, rangeTxt, text_color = tc)
    table.cell(panel, 0, 3, "Próximo", text_color = tc, text_halign = text.align_left)
    table.cell(panel, 1, 3, nextTxt, text_color = #f5b942, text_halign = text.align_left)

// ───────── Alertas ─────────
alertcondition(evSpring, "Spring", "Wyckoff: Spring detectado")
alertcondition(evUtad,   "UTAD",   "Wyckoff: UTAD detectado")
alertcondition(evSos,    "SOS",    "Wyckoff: SOS (sinal de força)")
alertcondition(evSow,    "SOW",    "Wyckoff: SOW (sinal de fraqueza)")
alertcondition(evLps,    "LPS",    "Wyckoff: LPS (entrada de acumulação)")
alertcondition(evLpsy,   "LPSY",   "Wyckoff: LPSY (entrada de distribuição)")
